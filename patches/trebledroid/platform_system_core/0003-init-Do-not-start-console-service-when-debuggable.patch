From d395c105da114bc49a10e7e5f5b22946c2c8d844 Mon Sep 17 00:00:00 2001
From: Raphael Mounier <mounierr07@gmail.com>
Date: Thu, 18 Dec 2025 09:14:44 +0100
Subject: [PATCH 3/4] init: Do not start console service when debuggable

Google added a check for this in R, when it's running it will show a
notification about that performance is impacted.

Change-Id: If47de0bf906aafae2a0bdb4373029c1d470a096f
---
 rootdir/init.rc | 3 ---
 1 file changed, 3 deletions(-)

diff --git a/rootdir/init.rc b/rootdir/init.rc
index 468c13905..a78cc1ebe 100644
--- a/rootdir/init.rc
+++ b/rootdir/init.rc
@@ -1311,9 +1311,6 @@ on property:ro.debuggable=1
     # Give reads to anyone for the accessibility trace folder on debug builds.
     chmod 0775 /data/misc/a11ytrace
 
-on init && property:ro.debuggable=1
-    start console
-
 # Multi-Gen LRU Experiment
 on property:persist.device_config.mglru_native.lru_gen_config=none
   write /sys/kernel/mm/lru_gen/enabled 0
-- 
2.25.1

