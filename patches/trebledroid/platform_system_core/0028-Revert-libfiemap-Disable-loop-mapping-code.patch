From cd9eda1acb2cbbe21195eeda01fd2d5888850ae9 Mon Sep 17 00:00:00 2001
From: Raphael Mounier <mounierr07@gmail.com>
Date: Sat, 20 Dec 2025 14:02:26 +0100
Subject: [PATCH 1/3] Revert "libfiemap: Disable loop mapping code."

Change-Id: I3cf692e26f3126a8ce8241ed6d3b684be616c962
---
 fs_mgr/libfiemap/image_manager.cpp | 17 +++++++++++------
 1 file changed, 11 insertions(+), 6 deletions(-)

diff --git a/fs_mgr/libfiemap/image_manager.cpp b/fs_mgr/libfiemap/image_manager.cpp
index a95b112bb..6c2f59e06 100644
--- a/fs_mgr/libfiemap/image_manager.cpp
+++ b/fs_mgr/libfiemap/image_manager.cpp
@@ -549,16 +549,21 @@ bool ImageManager::MapImageDevice(const std::string& name,
             return false;
         }
 
-        if (!can_use_devicemapper) {
-            LOG(ERROR) << "Cannot map image: /data must be mounted on top of device-mapper.";
-            return false;
-        }
+        if (can_use_devicemapper) {
+            if (!MapWithDmLinear(*partition_opener_.get(), name, timeout_ms, path)) {
+                return false;
+            }
+        } else if (!MapWithLoopDevice(name, timeout_ms, path)) {
+                  return false;
+               }
     }
-#endif
-
+#else
+    // In recovery, we can *only* use device-mapper, since partitions aren't
+    // mounted. That also means we cannot call GetBlockDeviceForFile.
     if (!MapWithDmLinear(*partition_opener_.get(), name, timeout_ms, path)) {
         return false;
     }
+#endif
 
     // Set a property so we remember this is mapped.
     auto prop_name = GetStatusPropertyName(name);
-- 
