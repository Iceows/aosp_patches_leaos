From 8e659bdfe58421a1fdbda6a5e8610d1a693fa7c6 Mon Sep 17 00:00:00 2001
From: Raphael Mounier <mounierr07@gmail.com>
Date: Sun, 16 Nov 2025 14:50:57 +0100
Subject: [PATCH] Build with release keys instead of test-keys

Help to pass safetynet

Change-Id: I303dc1018639f09c6c172404be04d9dc35a997f6
---
 core/sysprop.mk | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/core/sysprop.mk b/core/sysprop.mk
index dcde71bd1e..132a9a4da2 100644
--- a/core/sysprop.mk
+++ b/core/sysprop.mk
@@ -170,7 +170,7 @@ endif
 # Both of these tags will be removed and replaced with "release-keys"
 # when the target-files is signed in a post-build step.
 ifeq ($(DEFAULT_SYSTEM_DEV_CERTIFICATE),build/make/target/product/security/testkey)
-BUILD_KEYS := test-keys
+BUILD_KEYS := release-keys
 else
 BUILD_KEYS := dev-keys
 endif
