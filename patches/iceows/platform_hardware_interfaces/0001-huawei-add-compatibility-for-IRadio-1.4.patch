 RadioCompatBase::RadioCompatBase(std::shared_ptr<DriverContext> context, sp<V1_5::IRadio> hidlHal,
                                  std::shared_ptr<CallbackManager> cbMgr)
     : mContext(context),
-      mHal1_5(hidlHal),
+      mHal1_4(V1_4::IRadio::castFrom(hidlHal)),
