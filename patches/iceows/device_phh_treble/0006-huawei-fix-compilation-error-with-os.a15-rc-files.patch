 files/init.emui.huawei.os.a15.rc | 23 +----------------------
 1 file changed, 1 insertion(+), 22 deletions(-)

diff --git a/files/init.emui.huawei.os.a15.rc b/files/init.emui.huawei.os.a15.rc
index 195769a..5f78d84 100644
--- a/files/init.emui.huawei.os.a15.rc
